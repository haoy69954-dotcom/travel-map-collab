FROM node:22-alpine

WORKDIR /app
COPY package.json server.js ./
COPY public ./public

# CloudBase mounts persistent object storage at runtime. The mount must be
# writable before the first request creates the app's JSON state files.
ENV HOST=0.0.0.0
ENV PORT=4173
ENV DATA_DIR=/mnt/travel-data
EXPOSE 4173

CMD ["node", "server.js"]
